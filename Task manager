<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Manager — Celestine Ateka</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:#080810;--bg2:#0e0e1a;--bg3:#13131f;--bg4:#1a1a28;
      --border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.12);
      --text:#eae8f5;--muted:#6e6c85;--dim:#3a3855;
      --accent:#8b7cf8;--accent2:#b8a9ff;
      --green:#4ade9c;--orange:#f97c4a;--pink:#e879a0;--red:#f87171;--blue:#38bdf8;
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:3rem 1.5rem 5rem}
    body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(139,124,248,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(139,124,248,0.03) 1px,transparent 1px);background-size:60px 60px;pointer-events:none;z-index:0}
    .glow{position:fixed;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(139,124,248,0.07) 0%,transparent 70%);pointer-events:none;transform:translate(-50%,-50%);transition:left .14s ease,top .14s ease;z-index:0}
    .back-link{position:fixed;top:1.4rem;left:2rem;font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);text-decoration:none;display:flex;align-items:center;gap:.4rem;transition:color .2s;z-index:100}
    .back-link:hover{color:var(--accent2)}
    .app{position:relative;z-index:1;width:100%;max-width:800px;margin-top:1rem}

    /* HEADER */
    .app-header{margin-bottom:2rem;animation:fadeUp .6s ease both .1s}
    .app-eyebrow{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:.7rem;display:flex;align-items:center;gap:.6rem}
    .app-eyebrow::before{content:'';width:22px;height:1px;background:var(--accent)}
    .app-title{font-size:clamp(2rem,5vw,3rem);font-weight:800;letter-spacing:-.025em;line-height:1}
    .app-title .hi{color:var(--accent2)}

    /* STATS */
    .stats-bar{display:flex;gap:1px;background:var(--border);border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:2rem;animation:fadeUp .6s ease both .2s}
    .stat{flex:1;background:var(--bg2);padding:.9rem 1rem;display:flex;flex-direction:column;align-items:center;gap:2px}
    .stat .val{font-size:1.4rem;font-weight:800;line-height:1}
    .stat .lbl{font-family:'JetBrains Mono',monospace;font-size:.6rem;font-weight:400;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

    /* MAIN LAYOUT */
    .main-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;align-items:start;animation:fadeUp .6s ease both .3s}
    @media(max-width:700px){.main-grid{grid-template-columns:1fr}}

    /* PANEL */
    .panel{background:var(--bg2);border:1px solid var(--border);border-radius:14px;overflow:hidden}
    .panel-header{padding:.85rem 1.2rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
    .panel-title{font-family:'JetBrains Mono',monospace;font-size:.68rem;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
    .panel-body{padding:1.2rem}

    /* ADD TASK FORM */
    .form-group{margin-bottom:.9rem}
    .form-label{font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;display:block}
    .form-input{width:100%;background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:.7rem .9rem;font-family:'Syne',sans-serif;font-size:.9rem;font-weight:400;color:var(--text);outline:none;transition:border-color .2s,box-shadow .2s}
    .form-input::placeholder{color:var(--dim)}
    .form-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(139,124,248,0.1)}
    textarea.form-input{resize:vertical;min-height:70px;line-height:1.5}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}
    select.form-input{cursor:pointer}
    select.form-input option{background:var(--bg3);color:var(--text)}

    .add-btn{width:100%;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:.8rem;font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s,transform .15s;margin-top:.4rem}
    .add-btn:hover{background:var(--accent2);transform:translateY(-1px)}
    .add-btn:active{transform:scale(.98)}

    /* CALENDAR */
    .cal-nav{display:flex;align-items:center;justify-content:space-between}
    .cal-month{font-size:.95rem;font-weight:700;letter-spacing:-.01em}
    .cal-arrow{background:transparent;border:1px solid var(--border);border-radius:6px;color:var(--muted);width:28px;height:28px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;transition:all .2s}
    .cal-arrow:hover{border-color:var(--accent);color:var(--accent)}
    .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-top:.9rem}
    .cal-day-name{font-family:'JetBrains Mono',monospace;font-size:.58rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);text-align:center;padding:.3rem 0}
    .cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-size:.78rem;font-weight:600;cursor:pointer;transition:all .2s;position:relative;border:1px solid transparent}
    .cal-day:hover{background:var(--bg4);border-color:var(--border2)}
    .cal-day.empty{cursor:default;pointer-events:none}
    .cal-day.today{border-color:var(--accent);color:var(--accent)}
    .cal-day.selected{background:var(--accent);color:#fff;border-color:var(--accent)}
    .cal-day.has-task::after{content:'';position:absolute;bottom:3px;left:50%;transform:translateX(-50%);width:4px;height:4px;border-radius:50%;background:var(--green)}
    .cal-day.selected.has-task::after{background:#fff}
    .cal-day.other-month{opacity:.25}
    .cal-day.has-reminder::before{content:'';position:absolute;top:3px;right:3px;width:4px;height:4px;border-radius:50%;background:var(--orange)}

    /* TASK LIST PANEL */
    .filter-tabs{display:flex;gap:.4rem;padding:.8rem 1.2rem;border-bottom:1px solid var(--border);flex-wrap:wrap}
    .tab{font-family:'JetBrains Mono',monospace;font-size:.6rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;padding:.3rem .7rem;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:all .2s}
    .tab:hover{color:var(--text);border-color:var(--border2)}
    .tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}

    .task-list{padding:.8rem;display:flex;flex-direction:column;gap:.5rem;max-height:420px;overflow-y:auto}
    .task-list::-webkit-scrollbar{width:4px}
    .task-list::-webkit-scrollbar-track{background:transparent}
    .task-list::-webkit-scrollbar-thumb{background:var(--dim);border-radius:2px}

    .task-item{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:.8rem 1rem;transition:border-color .2s,transform .2s;position:relative;overflow:hidden;cursor:pointer}
    .task-item::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;transition:opacity .2s}
    .task-item.p-high::before{background:var(--red);opacity:.7}
    .task-item.p-med::before{background:var(--orange);opacity:.7}
    .task-item.p-low::before{background:var(--green);opacity:.7}
    .task-item:hover{border-color:var(--border2);transform:translateX(2px)}
    .task-item.done-item{opacity:.45}
    .task-item.done-item .ti-title{text-decoration:line-through;color:var(--muted)}

    .ti-row1{display:flex;align-items:flex-start;gap:.6rem}
    .ti-check{width:18px;height:18px;flex-shrink:0;border-radius:5px;border:1.5px solid var(--border2);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;color:transparent;font-size:.65rem;margin-top:2px}
    .ti-check:hover{border-color:var(--accent);color:var(--accent)}
    .task-item.done-item .ti-check{background:var(--accent);border-color:var(--accent);color:#fff}
    .ti-content{flex:1;min-width:0}
    .ti-title{font-size:.88rem;font-weight:700;line-height:1.3;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ti-desc{font-size:.75rem;color:var(--muted);line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .ti-del{width:24px;height:24px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.75rem;transition:all .2s;flex-shrink:0}
    .ti-del:hover{background:rgba(248,113,113,0.1);border-color:rgba(248,113,113,0.3);color:var(--red)}

    .ti-row2{display:flex;align-items:center;gap:.4rem;margin-top:.5rem;flex-wrap:wrap}
    .badge{font-family:'JetBrains Mono',monospace;font-size:.58rem;font-weight:500;letter-spacing:.06em;padding:.15rem .45rem;border-radius:4px}
    .b-high{background:rgba(248,113,113,0.1);color:var(--red);border:1px solid rgba(248,113,113,0.2)}
    .b-med{background:rgba(249,124,74,0.1);color:var(--orange);border:1px solid rgba(249,124,74,0.2)}
    .b-low{background:rgba(74,222,156,0.1);color:var(--green);border:1px solid rgba(74,222,156,0.2)}
    .b-date{background:rgba(56,189,248,0.08);color:var(--blue);border:1px solid rgba(56,189,248,0.15)}
    .b-reminder{background:rgba(249,124,74,0.08);color:var(--orange);border:1px solid rgba(249,124,74,0.15)}
    .b-cat{background:rgba(139,124,248,0.08);color:var(--accent2);border:1px solid rgba(139,124,248,0.15)}
    .b-overdue{background:rgba(248,113,113,0.1);color:var(--red);border:1px solid rgba(248,113,113,0.3)}

    /* EMPTY */
    .empty-state{text-align:center;padding:2.5rem 1rem}
    .empty-icon{font-size:2rem;margin-bottom:.8rem;opacity:.4}
    .empty-state p{font-family:'JetBrains Mono',monospace;font-size:.7rem;color:var(--muted);letter-spacing:.06em}

    /* BOTTOM BAR */
    .bottom-bar{display:flex;justify-content:flex-end;gap:.6rem;padding:.8rem 1rem;border-top:1px solid var(--border)}
    .ghost-btn{font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .8rem;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:all .2s}
    .ghost-btn:hover{border-color:var(--red);color:var(--red)}

    /* MODAL (TASK DETAIL) */
    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.65);backdrop-filter:blur(4px);z-index:200;display:none;align-items:center;justify-content:center;padding:1.5rem}
    .modal-overlay.open{display:flex}
    .modal{background:var(--bg2);border:1px solid var(--border2);border-radius:16px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;animation:modalIn .25s cubic-bezier(.16,1,.3,1)}
    @keyframes modalIn{from{opacity:0;transform:scale(.94) translateY(10px)}to{opacity:1;transform:none}}
    .modal-header{padding:1.3rem 1.5rem 1rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
    .modal-title-text{font-size:1rem;font-weight:700;letter-spacing:-.01em}
    .modal-close{width:30px;height:30px;border-radius:7px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:all .2s}
    .modal-close:hover{border-color:var(--red);color:var(--red)}
    .modal-body{padding:1.3rem 1.5rem}
    .modal-label{font-family:'JetBrains Mono',monospace;font-size:.62rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.35rem;margin-top:1rem;display:block}
    .modal-label:first-child{margin-top:0}
    .modal-val{font-size:.92rem;font-weight:500;color:var(--text);line-height:1.5}
    .modal-desc{font-size:.85rem;color:var(--muted);line-height:1.6}
    .modal-footer{padding:.9rem 1.5rem;border-top:1px solid var(--border);display:flex;gap:.7rem;flex-wrap:wrap}
    .modal-btn{font-family:'JetBrains Mono',monospace;font-size:.65rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;padding:.45rem .9rem;border-radius:7px;cursor:pointer;transition:all .2s;border:1px solid var(--border2);background:transparent;color:var(--text)}
    .modal-btn:hover{background:var(--bg4)}
    .modal-btn.danger{border-color:rgba(248,113,113,0.3);color:var(--red)}
    .modal-btn.danger:hover{background:rgba(248,113,113,0.1)}
    .modal-btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
    .modal-btn.primary:hover{background:var(--accent2);border-color:var(--accent2)}
    .modal-btn.success{background:var(--green);border-color:var(--green);color:#080810}
    .modal-btn.success:hover{opacity:.88}

    /* EDIT FORM inside modal */
    .edit-form .form-group{margin-bottom:.85rem}
    .edit-form .form-label{font-family:'JetBrains Mono',monospace;font-size:.6rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:.35rem;display:block}
    .edit-form .form-input{width:100%;background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:.65rem .9rem;font-family:'Syne',sans-serif;font-size:.88rem;font-weight:400;color:var(--text);outline:none;transition:border-color .2s,box-shadow .2s}
    .edit-form .form-input::placeholder{color:var(--dim)}
    .edit-form .form-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(139,124,248,0.1)}
    .edit-form textarea.form-input{resize:vertical;min-height:65px;line-height:1.5}
    .edit-form select.form-input{cursor:pointer}
    .edit-form select.form-input option{background:var(--bg3);color:var(--text)}
    .edit-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}

    /* edit pencil btn on task card */
    .ti-edit{width:24px;height:24px;border-radius:6px;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.75rem;transition:all .2s;flex-shrink:0}
    .ti-edit:hover{background:rgba(139,124,248,0.1);border-color:rgba(139,124,248,0.3);color:var(--accent)}

    /* SUB-ITEMS */
    .sub-items{display:flex;flex-direction:column;gap:3px;margin-top:.55rem;padding-top:.55rem;border-top:1px solid var(--border)}
    .sub-item{display:flex;align-items:center;gap:.55rem;cursor:pointer;padding:.25rem .3rem;border-radius:5px;transition:background .15s;user-select:none}
    .sub-item:hover{background:var(--bg4)}
    .sub-icon{width:17px;height:17px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:700;flex-shrink:0;transition:all .2s}
    .sub-icon.done-icon{background:rgba(74,222,156,0.15);color:var(--green);border:1.5px solid rgba(74,222,156,0.35)}
    .sub-icon.undone-icon{background:rgba(248,113,113,0.1);color:var(--red);border:1.5px solid rgba(248,113,113,0.25)}
    .sub-label{font-size:.8rem;font-weight:500;line-height:1.3;flex:1}
    .sub-label.done-label{text-decoration:line-through;color:var(--muted)}
    .sub-progress{display:flex;align-items:center;gap:.5rem;margin-top:.4rem}
    .sub-progress-track{flex:1;height:2px;background:var(--border2);border-radius:1px;overflow:hidden}
    .sub-progress-fill{height:100%;border-radius:1px;background:var(--green);transition:width .4s ease}
    .sub-progress-label{font-family:'JetBrains Mono',monospace;font-size:.58rem;color:var(--muted);white-space:nowrap}

    /* TOAST */
    .toast-wrap{position:fixed;bottom:2rem;right:2rem;z-index:300;display:flex;flex-direction:column;gap:.5rem}
    .toast{background:var(--bg3);border:1px solid var(--border2);border-radius:10px;padding:.7rem 1.1rem;font-family:'JetBrains Mono',monospace;font-size:.72rem;letter-spacing:.04em;color:var(--text);display:flex;align-items:center;gap:.6rem;animation:toastIn .3s ease;max-width:300px}
    .toast.removing{animation:toastOut .3s ease forwards}
    @keyframes toastIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
    @keyframes toastOut{to{opacity:0;transform:translateX(20px)}}
    .toast-icon{font-size:.9rem}

    /* PORTFOLIO BADGE */
    .portfolio-badge{margin-top:3rem;display:flex;align-items:center;gap:.7rem;font-family:'JetBrains Mono',monospace;font-size:.65rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);animation:fadeUp .6s ease both .75s}
    .portfolio-badge a{color:var(--accent);text-decoration:none;transition:color .2s}
    .portfolio-badge a:hover{color:var(--accent2)}

    @keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

    .selected-date-label{font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--accent2);letter-spacing:.06em;margin-top:.6rem;text-align:center;min-height:1em}
  </style>
</head>
<body>

<div class="glow" id="glow"></div>
<a href="index.html" class="back-link">← Portfolio</a>
<div class="toast-wrap" id="toastWrap"></div>

<!-- DETAIL MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal" id="modal">
    <div class="modal-header">
      <span class="modal-title-text" id="modalTitleText">Task Detail</span>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer" id="modalFooter"></div>
  </div>
</div>

<div class="app">
  <div class="app-header">
    <div class="app-eyebrow">Project · Task Manager</div>
    <h1 class="app-title">Get Things<br><span class="hi">Done.</span></h1>
  </div>

  <div class="stats-bar">
    <div class="stat"><div class="val" id="statTotal" style="color:var(--text)">0</div><div class="lbl">Total</div></div>
    <div class="stat"><div class="val" id="statActive" style="color:var(--accent)">0</div><div class="lbl">Active</div></div>
    <div class="stat"><div class="val" id="statDone" style="color:var(--green)">0</div><div class="lbl">Done</div></div>
    <div class="stat"><div class="val" id="statToday" style="color:var(--blue)">0</div><div class="lbl">Today</div></div>
    <div class="stat"><div class="val" id="statOverdue" style="color:var(--red)">0</div><div class="lbl">Overdue</div></div>
  </div>

  <div class="main-grid">

    <!-- LEFT: ADD TASK + CALENDAR -->
    <div style="display:flex;flex-direction:column;gap:1.2rem">

      <!-- ADD TASK PANEL -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">New Task</span>
        </div>
        <div class="panel-body">
          <div class="form-group">
            <label class="form-label">Title *</label>
            <input id="fTitle" class="form-input" placeholder="Task title…" autocomplete="off">
          </div>
          <div class="form-group">
            <label class="form-label">Description</label>
            <textarea id="fDesc" class="form-input" placeholder="Optional details — or list options: Item 1, Item 2, Item 3" rows="2"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Category</label>
              <select id="fCat" class="form-input">
                <option value="">— None —</option>
                <option value="Work">Work</option>
                <option value="Personal">Personal</option>
                <option value="Study">Study</option>
                <option value="Health">Health</option>
                <option value="Finance">Finance</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Priority</label>
              <select id="fPriority" class="form-input">
                <option value="med">Medium</option>
                <option value="high">High</option>
                <option value="low">Low</option>
              </select>
            </div>
          </div>
          <div class="form-row" style="margin-top:.9rem">
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Due Date</label>
              <input id="fDate" class="form-input" type="date">
            </div>
            <div class="form-group" style="margin-bottom:0">
              <label class="form-label">Due Time</label>
              <input id="fTime" class="form-input" type="time">
            </div>
          </div>
          <div class="form-group" style="margin-top:.9rem;margin-bottom:0">
            <label class="form-label">Reminder</label>
            <select id="fReminder" class="form-input">
              <option value="">No reminder</option>
              <option value="5">5 minutes before</option>
              <option value="15">15 minutes before</option>
              <option value="30">30 minutes before</option>
              <option value="60">1 hour before</option>
              <option value="1440">1 day before</option>
            </select>
          </div>
          <button class="add-btn" onclick="addTask()" style="margin-top:1rem">+ Add Task</button>
        </div>
      </div>

      <!-- CALENDAR PANEL -->
      <div class="panel">
        <div class="panel-header">
          <span class="panel-title">Calendar</span>
        </div>
        <div class="panel-body">
          <div class="cal-nav">
            <button class="cal-arrow" onclick="changeMonth(-1)">‹</button>
            <span class="cal-month" id="calMonth"></span>
            <button class="cal-arrow" onclick="changeMonth(1)">›</button>
          </div>
          <div class="cal-grid" id="calGrid"></div>
          <div class="selected-date-label" id="selectedDateLabel"></div>
        </div>
      </div>

    </div>

    <!-- RIGHT: TASK LIST -->
    <div class="panel" style="display:flex;flex-direction:column">
      <div class="panel-header">
        <span class="panel-title" id="listPanelTitle">All Tasks</span>
        <span id="listCount" style="font-family:'JetBrains Mono',monospace;font-size:.62rem;color:var(--muted)"></span>
      </div>
      <div class="filter-tabs">
        <button class="tab active" onclick="setFilter('all',this)">All</button>
        <button class="tab" onclick="setFilter('active',this)">Active</button>
        <button class="tab" onclick="setFilter('done',this)">Done</button>
        <button class="tab" onclick="setFilter('today',this)">Today</button>
        <button class="tab" onclick="setFilter('overdue',this)">Overdue</button>
        <button class="tab" onclick="setFilter('high',this)">🔴 High</button>
      </div>
      <div class="task-list" id="taskList"></div>
      <div class="bottom-bar">
        <button class="ghost-btn" onclick="clearDone()">Clear Done</button>
        <button class="ghost-btn" onclick="clearAll()">Clear All</button>
      </div>
    </div>

  </div>

  <div class="portfolio-badge">
    Built by <a href="index.html">Celestine Ateka</a> &nbsp;·&nbsp;
    <a href="https://github.com/atekacelestine/task-manager" target="_blank" rel="noopener">GitHub ↗</a>
  </div>
</div>

<script>
// ── CURSOR GLOW ──────────────────────────────────
const glowEl = document.getElementById('glow');
document.addEventListener('mousemove', e => {
  glowEl.style.left = e.clientX + 'px';
  glowEl.style.top  = e.clientY + 'px';
});

// ── STATE ─────────────────────────────────────────
let tasks  = JSON.parse(localStorage.getItem('ca_tasks2') || '[]');
let filter = 'all';
let calYear, calMonth, selectedDate = null;
let reminderTimers = {};

const now = () => new Date();
const todayStr = () => now().toISOString().slice(0,10);

function save() { localStorage.setItem('ca_tasks2', JSON.stringify(tasks)); }

// ── ADD TASK ──────────────────────────────────────
function addTask() {
  const title = document.getElementById('fTitle').value.trim();
  if (!title) { toast('⚠️', 'Title is required'); document.getElementById('fTitle').focus(); return; }

  const dueDate  = document.getElementById('fDate').value;
  const dueTime  = document.getElementById('fTime').value;
  const reminder = document.getElementById('fReminder').value;

  const desc = document.getElementById('fDesc').value.trim();

  const task = {
    id:       Date.now(),
    title,
    desc,
    cat:      document.getElementById('fCat').value,
    priority: document.getElementById('fPriority').value,
    dueDate,
    dueTime,
    reminder,
    done:     false,
    subDone:  desc.includes(',') ? Array(desc.split(',').filter(s=>s.trim()).length).fill(false) : [],
    created:  new Date().toISOString()
  };

  tasks.unshift(task);
  save();

  // schedule reminder
  if (reminder && dueDate) scheduleReminder(task);

  // reset form (keep date)
  document.getElementById('fTitle').value    = '';
  document.getElementById('fDesc').value     = '';
  document.getElementById('fCat').value      = '';
  document.getElementById('fPriority').value = 'med';
  document.getElementById('fTime').value     = '';
  document.getElementById('fReminder').value = '';

  toast('✅', `"${title}" added`);
  render();
  renderCal();
}

// ── REMINDER SCHEDULING ───────────────────────────
function scheduleReminder(task) {
  if (!task.dueDate || !task.reminder) return;
  const timeStr = task.dueTime || '09:00';
  const due  = new Date(`${task.dueDate}T${timeStr}`);
  const fire = new Date(due.getTime() - task.reminder * 60 * 1000);
  const ms   = fire.getTime() - Date.now();
  if (ms <= 0) return;

  if (reminderTimers[task.id]) clearTimeout(reminderTimers[task.id]);
  reminderTimers[task.id] = setTimeout(() => {
    toast('🔔', `Reminder: "${task.title}"`);
    // browser notification
    if (Notification && Notification.permission === 'granted') {
      new Notification('Task Reminder', {
        body: task.title + (task.desc ? '\n' + task.desc : ''),
        icon: ''
      });
    }
  }, ms);
}

// Request notification permission on load
if (typeof Notification !== 'undefined' && Notification.permission === 'default') {
  Notification.requestPermission();
}

// Re-schedule all reminders on load
tasks.forEach(t => { if (!t.done) scheduleReminder(t); });

// ── HELPERS ───────────────────────────────────────
function isOverdue(t) {
  if (!t.dueDate || t.done) return false;
  const today = todayStr();
  if (t.dueDate < today) return true;
  if (t.dueDate === today && t.dueTime) {
    return new Date(`${t.dueDate}T${t.dueTime}`) < now();
  }
  return false;
}

function isToday(t) {
  return t.dueDate === todayStr();
}

function fmtDate(d, ti) {
  if (!d) return '';
  const dt = new Date(d + 'T00:00:00');
  const label = dt.toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
  return ti ? label + ' ' + ti : label;
}

// ── FILTER ────────────────────────────────────────
function setFilter(f, btn) {
  filter = f;
  selectedDate = null;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  renderCal();
  render();
}

function getFiltered() {
  if (selectedDate)    return tasks.filter(t => t.dueDate === selectedDate);
  if (filter === 'active')  return tasks.filter(t => !t.done);
  if (filter === 'done')    return tasks.filter(t => t.done);
  if (filter === 'today')   return tasks.filter(t => isToday(t));
  if (filter === 'overdue') return tasks.filter(t => isOverdue(t));
  if (filter === 'high')    return tasks.filter(t => t.priority === 'high');
  return tasks;
}

// ── TOGGLE / DELETE ───────────────────────────────
function toggleDone(id, e) {
  e && e.stopPropagation();
  const t = tasks.find(t => t.id === id);
  if (!t) return;
  t.done = !t.done;
  if (t.done && reminderTimers[id]) { clearTimeout(reminderTimers[id]); delete reminderTimers[id]; }
  if (!t.done) scheduleReminder(t);
  save(); render(); renderCal(); updateStats();
}

function deleteTask(id, e) {
  e && e.stopPropagation();
  if (reminderTimers[id]) { clearTimeout(reminderTimers[id]); delete reminderTimers[id]; }
  tasks = tasks.filter(t => t.id !== id);
  save(); render(); renderCal(); updateStats();
  closeModal();
  toast('🗑️', 'Task deleted');
}

function clearDone() { tasks = tasks.filter(t => !t.done); save(); render(); renderCal(); updateStats(); toast('🧹','Cleared completed tasks'); }
function clearAll()  { if (!tasks.length) return; tasks = []; save(); render(); renderCal(); updateStats(); toast('🗑️','All tasks cleared'); }

// ── STATS ─────────────────────────────────────────
function updateStats() {
  const today = todayStr();
  document.getElementById('statTotal').textContent   = tasks.length;
  document.getElementById('statActive').textContent  = tasks.filter(t => !t.done).length;
  document.getElementById('statDone').textContent    = tasks.filter(t => t.done).length;
  document.getElementById('statToday').textContent   = tasks.filter(t => isToday(t) && !t.done).length;
  document.getElementById('statOverdue').textContent = tasks.filter(t => isOverdue(t)).length;
}

// ── RENDER TASK LIST ──────────────────────────────
function render() {
  updateStats();
  const list = document.getElementById('taskList');
  const filtered = getFiltered();
  const titleEl = document.getElementById('listPanelTitle');
  const countEl = document.getElementById('listCount');

  if (selectedDate) {
    const dt = new Date(selectedDate + 'T00:00:00');
    titleEl.textContent = dt.toLocaleDateString('en-US',{weekday:'long',month:'short',day:'numeric'});
  } else {
    const labels = {all:'All Tasks',active:'Active',done:'Completed',today:"Today's Tasks",overdue:'Overdue',high:'High Priority'};
    titleEl.textContent = labels[filter] || 'Tasks';
  }
  countEl.textContent = filtered.length + ' task' + (filtered.length !== 1 ? 's' : '');

  if (!filtered.length) {
    list.innerHTML = `<div class="empty-state"><div class="empty-icon">✦</div><p>No tasks here</p></div>`;
    return;
  }

  const sorted = [...filtered].sort((a,b) => {
    if (!a.dueDate && b.dueDate) return 1;
    if (a.dueDate && !b.dueDate) return -1;
    if (a.dueDate && b.dueDate && a.dueDate !== b.dueDate) return a.dueDate.localeCompare(b.dueDate);
    const pOrd = {high:0,med:1,low:2};
    return pOrd[a.priority] - pOrd[b.priority];
  });

  list.innerHTML = sorted.map(t => {
    const over = isOverdue(t);
    const parts = parseSubItems(t.desc);
    const isMulti = parts.length > 1;
    const doneCount = isMulti ? (t.subDone || []).filter(Boolean).length : 0;
    const allSubDone = isMulti && doneCount === parts.length;

    const subItemsHtml = isMulti ? `
      <div class="sub-items">
        ${parts.map((p, i) => {
          const checked = t.subDone && t.subDone[i];
          return `<div class="sub-item" onclick="toggleSubItem(${t.id},${i},event)">
            <div class="sub-icon ${checked ? 'done-icon' : 'undone-icon'}">${checked ? '✓' : '✕'}</div>
            <span class="sub-label ${checked ? 'done-label' : ''}">${escHtml(p)}</span>
          </div>`;
        }).join('')}
        <div class="sub-progress">
          <div class="sub-progress-track"><div class="sub-progress-fill" style="width:${Math.round(doneCount/parts.length*100)}%"></div></div>
          <span class="sub-progress-label">${doneCount}/${parts.length}</span>
        </div>
      </div>` : '';

    return `
    <div class="task-item p-${t.priority} ${(t.done || allSubDone) ? 'done-item' : ''}" onclick="openModal(${t.id},false,event)">
      <div class="ti-row1">
        <button class="ti-check" onclick="toggleDone(${t.id},event)" title="Toggle done">✓</button>
        <div class="ti-content">
          <div class="ti-title">${escHtml(t.title)}</div>
          ${!isMulti && t.desc ? `<div class="ti-desc">${escHtml(t.desc)}</div>` : ''}
        </div>
        <button class="ti-edit" onclick="openModal(${t.id},true,event)" title="Edit task">✎</button>
        <button class="ti-del" onclick="deleteTask(${t.id},event)" title="Delete">✕</button>
      </div>
      ${subItemsHtml}
      <div class="ti-row2">
        <span class="badge b-${t.priority}">${t.priority.toUpperCase()}</span>
        ${t.cat ? `<span class="badge b-cat">${escHtml(t.cat)}</span>` : ''}
        ${isMulti ? `<span class="badge b-cat" style="background:rgba(139,124,248,0.08);color:var(--accent2);border-color:rgba(139,124,248,0.15)">${doneCount}/${parts.length} done</span>` : ''}
        ${t.dueDate ? `<span class="badge ${over && !t.done ? 'b-overdue' : 'b-date'}">${over && !t.done ? '⚠ ' : '📅 '}${fmtDate(t.dueDate, t.dueTime)}</span>` : ''}
        ${t.reminder ? `<span class="badge b-reminder">🔔 ${reminderLabel(t.reminder)}</span>` : ''}
      </div>
    </div>`;
  }).join('');
}

// ── SUB-ITEMS ─────────────────────────────────────
function parseSubItems(desc) {
  if (!desc || !desc.includes(',')) return [];
  return desc.split(',').map(s => s.trim()).filter(Boolean);
}

function toggleSubItem(taskId, index, e) {
  e && e.stopPropagation();
  const t = tasks.find(t => t.id === taskId);
  if (!t) return;
  const parts = parseSubItems(t.desc);
  if (!t.subDone || t.subDone.length !== parts.length) {
    t.subDone = Array(parts.length).fill(false);
  }
  t.subDone[index] = !t.subDone[index];
  // auto-mark whole task done if all sub-items checked
  if (t.subDone.every(Boolean)) {
    t.done = true;
  } else if (t.done) {
    t.done = false;
  }
  save(); render(); renderCal(); updateStats();
}

function reminderLabel(r) {
  const map = {'5':'5m before','15':'15m before','30':'30m before','60':'1h before','1440':'1d before'};
  return map[r] || r + 'm';
}

// ── MODAL ─────────────────────────────────────────
function openModal(id, editMode, e) {
  if (e) e.stopPropagation();
  const t = tasks.find(t => t.id === id);
  if (!t) return;

  if (editMode) {
    showEditModal(t);
  } else {
    showViewModal(t);
  }
  document.getElementById('modalOverlay').classList.add('open');
}

function showViewModal(t) {
  const over = isOverdue(t);
  const parts = parseSubItems(t.desc);
  const isMulti = parts.length > 1;
  const doneCount = isMulti ? (t.subDone || []).filter(Boolean).length : 0;

  const subHtml = isMulti ? `
    <span class="modal-label">Items (${doneCount}/${parts.length} done)</span>
    <div style="display:flex;flex-direction:column;gap:4px;margin-bottom:.5rem">
      ${parts.map((p, i) => {
        const checked = t.subDone && t.subDone[i];
        return `<div style="display:flex;align-items:center;gap:.5rem;padding:.3rem .4rem;border-radius:6px;background:var(--bg3)">
          <div style="width:16px;height:16px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;flex-shrink:0;${checked ? 'background:rgba(74,222,156,0.15);color:var(--green);border:1.5px solid rgba(74,222,156,0.35)' : 'background:rgba(248,113,113,0.1);color:var(--red);border:1.5px solid rgba(248,113,113,0.25)'}">${checked ? '✓' : '✕'}</div>
          <span style="font-size:.82rem;font-weight:500;${checked ? 'text-decoration:line-through;color:var(--muted)' : ''}">${escHtml(p)}</span>
        </div>`;
      }).join('')}
    </div>` : '';

  document.getElementById('modalTitleText').textContent = t.title;
  document.getElementById('modalBody').innerHTML = `
    ${subHtml}
    ${t.desc ? `<span class="modal-label">Description</span><div class="modal-desc">${escHtml(t.desc)}</div>` : ''}
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:${(t.desc||isMulti)?'1rem':'0'}">
      <div><span class="modal-label">Priority</span><div><span class="badge b-${t.priority}" style="font-size:.72rem;padding:.25rem .6rem">${t.priority.toUpperCase()}</span></div></div>
      <div><span class="modal-label">Status</span><div style="font-size:.88rem;font-weight:600;color:${t.done?'var(--green)':over?'var(--red)':'var(--accent)'}">${t.done ? '✓ Done' : over ? '⚠ Overdue' : '● Active'}</div></div>
      ${t.cat ? `<div><span class="modal-label">Category</span><div><span class="badge b-cat" style="font-size:.72rem;padding:.25rem .6rem">${escHtml(t.cat)}</span></div></div>` : ''}
      ${t.dueDate ? `<div><span class="modal-label">Due</span><div class="modal-val" style="font-size:.85rem">${fmtDate(t.dueDate, t.dueTime)}</div></div>` : ''}
      ${t.reminder ? `<div><span class="modal-label">Reminder</span><div class="modal-val" style="font-size:.85rem">🔔 ${reminderLabel(t.reminder)}</div></div>` : ''}
    </div>
    <span class="modal-label" style="margin-top:1rem">Created</span>
    <div class="modal-val" style="font-size:.78rem;color:var(--muted)">${new Date(t.created).toLocaleString()}</div>
  `;
  document.getElementById('modalFooter').innerHTML = `
    <button class="modal-btn primary" onclick="toggleDone(${t.id}); render(); renderCal(); closeModal();">${t.done ? 'Mark Active' : 'Mark Done'}</button>
    <button class="modal-btn" onclick="showEditModal(tasks.find(x=>x.id===${t.id}))">✎ Edit</button>
    <button class="modal-btn danger" onclick="deleteTask(${t.id})">Delete</button>
    <button class="modal-btn" onclick="closeModal()">Close</button>
  `;
}

function showEditModal(t) {
  document.getElementById('modalTitleText').textContent = 'Edit Task';
  document.getElementById('modalBody').innerHTML = `
    <div class="edit-form">
      <div class="form-group">
        <label class="form-label">Title *</label>
        <input id="eFTitle" class="form-input" value="${escAttr(t.title)}" placeholder="Task title…" autocomplete="off">
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea id="eFDesc" class="form-input" placeholder="Optional details — or list options: Item 1, Item 2, Item 3" rows="2">${escHtml(t.desc||'')}</textarea>
      </div>
      <div class="form-row">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Category</label>
          <select id="eFCat" class="form-input">
            <option value="" ${!t.cat?'selected':''}>— None —</option>
            ${['Work','Personal','Study','Health','Finance','Other'].map(c=>`<option value="${c}" ${t.cat===c?'selected':''}>${c}</option>`).join('')}
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Priority</label>
          <select id="eFPriority" class="form-input">
            <option value="high" ${t.priority==='high'?'selected':''}>High</option>
            <option value="med"  ${t.priority==='med'?'selected':''}>Medium</option>
            <option value="low"  ${t.priority==='low'?'selected':''}>Low</option>
          </select>
        </div>
      </div>
      <div class="form-row" style="margin-top:.85rem">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Due Date</label>
          <input id="eFDate" class="form-input" type="date" value="${t.dueDate||''}">
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Due Time</label>
          <input id="eFTime" class="form-input" type="time" value="${t.dueTime||''}">
        </div>
      </div>
      <div class="form-group" style="margin-top:.85rem;margin-bottom:0">
        <label class="form-label">Reminder</label>
        <select id="eFReminder" class="form-input">
          <option value=""    ${!t.reminder?'selected':''}>No reminder</option>
          <option value="5"   ${t.reminder==='5'?'selected':''}>5 minutes before</option>
          <option value="15"  ${t.reminder==='15'?'selected':''}>15 minutes before</option>
          <option value="30"  ${t.reminder==='30'?'selected':''}>30 minutes before</option>
          <option value="60"  ${t.reminder==='60'?'selected':''}>1 hour before</option>
          <option value="1440"${t.reminder==='1440'?'selected':''}>1 day before</option>
        </select>
      </div>
    </div>
  `;
  // focus title
  setTimeout(() => { const el = document.getElementById('eFTitle'); if(el) el.focus(); }, 50);

  document.getElementById('modalFooter').innerHTML = `
    <button class="modal-btn success" onclick="saveEdit(${t.id})">✓ Save Changes</button>
    <button class="modal-btn" onclick="showViewModal(tasks.find(x=>x.id===${t.id}))">← Back</button>
    <button class="modal-btn danger" onclick="deleteTask(${t.id})">Delete</button>
  `;
}

function saveEdit(id) {
  const t = tasks.find(t => t.id === id);
  if (!t) return;

  const title = (document.getElementById('eFTitle').value || '').trim();
  if (!title) { toast('⚠️', 'Title cannot be empty'); document.getElementById('eFTitle').focus(); return; }

  // cancel old reminder timer
  if (reminderTimers[id]) { clearTimeout(reminderTimers[id]); delete reminderTimers[id]; }

  t.title    = title;
  t.desc     = (document.getElementById('eFDesc').value || '').trim();
  t.cat      = document.getElementById('eFCat').value;
  t.priority = document.getElementById('eFPriority').value;
  t.dueDate  = document.getElementById('eFDate').value;
  t.dueTime  = document.getElementById('eFTime').value;
  t.reminder = document.getElementById('eFReminder').value;
  t.edited   = new Date().toISOString();
  // rebuild subDone to match new desc parts
  const newDesc = t.desc;
  const newParts = parseSubItems(newDesc);
  if (newParts.length > 1) {
    const old = t.subDone || [];
    t.subDone = newParts.map((_, i) => old[i] || false);
    t.done = t.subDone.every(Boolean);
  } else {
    t.subDone = [];
  }

  save();
  if (!t.done) scheduleReminder(t);
  render();
  renderCal();
  updateStats();
  toast('✏️', `"${title}" updated`);
  closeModal();
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
}

document.getElementById('modalOverlay').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeModal();
});

document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

// ── CALENDAR ──────────────────────────────────────
function initCal() {
  const d = new Date();
  calYear  = d.getFullYear();
  calMonth = d.getMonth();
  renderCal();
}

function changeMonth(dir) {
  calMonth += dir;
  if (calMonth > 11) { calMonth = 0;  calYear++; }
  if (calMonth < 0)  { calMonth = 11; calYear--; }
  selectedDate = null;
  document.getElementById('selectedDateLabel').textContent = '';
  renderCal();
  render();
}

function renderCal() {
  const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  document.getElementById('calMonth').textContent = `${monthNames[calMonth]} ${calYear}`;

  const today = todayStr();
  const taskDates   = new Set(tasks.map(t => t.dueDate).filter(Boolean));
  const reminDates  = new Set(tasks.filter(t => t.reminder && t.dueDate).map(t => t.dueDate));

  const firstDay = new Date(calYear, calMonth, 1).getDay();
  const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
  const daysInPrev  = new Date(calYear, calMonth, 0).getDate();

  const dayNames = ['Su','Mo','Tu','We','Th','Fr','Sa'];
  let html = dayNames.map(d => `<div class="cal-day-name">${d}</div>`).join('');

  // prev month filler
  for (let i = firstDay - 1; i >= 0; i--) {
    const dateStr = `${calYear}-${String(calMonth === 0 ? 12 : calMonth).padStart(2,'0')}-${String(daysInPrev - i).padStart(2,'0')}`;
    html += `<div class="cal-day other-month empty">${daysInPrev - i}</div>`;
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    let cls = 'cal-day';
    if (dateStr === today)         cls += ' today';
    if (dateStr === selectedDate)  cls += ' selected';
    if (taskDates.has(dateStr))    cls += ' has-task';
    if (reminDates.has(dateStr))   cls += ' has-reminder';
    html += `<div class="${cls}" onclick="selectDate('${dateStr}')">${d}</div>`;
  }

  document.getElementById('calGrid').innerHTML = html;
}

function selectDate(dateStr) {
  if (selectedDate === dateStr) {
    selectedDate = null;
    document.getElementById('selectedDateLabel').textContent = '';
    // deactivate all filter tabs, reactivate 'all'
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelector('.tab').classList.add('active');
    filter = 'all';
  } else {
    selectedDate = dateStr;
    // prefill date input
    document.getElementById('fDate').value = dateStr;
    const dt = new Date(dateStr + 'T00:00:00');
    document.getElementById('selectedDateLabel').textContent =
      dt.toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'});
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  }
  render();
  renderCal();
}

// ── TOAST ─────────────────────────────────────────
function toast(icon, msg) {
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className = 'toast';
  el.innerHTML = `<span class="toast-icon">${icon}</span>${escHtml(msg)}`;
  wrap.appendChild(el);
  setTimeout(() => {
    el.classList.add('removing');
    setTimeout(() => el.remove(), 300);
  }, 3000);
}

// ── UTILS ─────────────────────────────────────────
function escHtml(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function escAttr(s) {
  if (!s) return '';
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ── ENTER KEY ─────────────────────────────────────
document.getElementById('fTitle').addEventListener('keydown', e => {
  if (e.key === 'Enter') addTask();
});

// ── INIT ──────────────────────────────────────────
initCal();
render();
</script>
</body>
</html>
